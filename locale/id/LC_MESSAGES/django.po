#, python-format
msgid "Unlimited listings — active until %(date)s."
msgstr "Listing tanpa batas — aktif hingga %(date)s."

#: .\templates\olretail\seller_subscription.html:36
#, python-format
msgid ""
"Expires in %(days)s day(s) — renew below to avoid losing the ability to post"
" new products."
msgstr ""
"Kedaluwarsa dalam %(days)s hari — perbarui di bawah agar tidak kehilangan "
"kemampuan memposting produk baru."

